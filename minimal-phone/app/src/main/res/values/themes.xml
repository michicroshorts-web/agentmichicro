<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Plain platform theme so we don't need the Material Components (XML) library.
        All real UI is drawn by Jetpack Compose; this only styles the window itself.
    -->
    <style name="Theme.MinimalPhone" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
